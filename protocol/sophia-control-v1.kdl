// Experimental wire specification, not a registered runtime endpoint.
// Fixed byte arrays are zero padded; semantic rules live in the companion spec.
protocol "sophia_control_v1" frame-version=1 interface-major=1 interface-revision=2 max-payload=65536 max-commands=259 max-name-bytes=128 {
    owner "policy" value=1
    owner "session" value=2
    completion "policy-commit" value=1
    completion "session-settlement" value=2
    outcome "committed" value=1
    outcome "completed" value=2
    outcome "unchanged" value=3
    outcome "rejected" value=4
    outcome "stale" value=5
    outcome "denied" value=6
    outcome "unavailable" value=7
    outcome "overloaded" value=8
    outcome "timed-out" value=9
    outcome "indeterminate" value=10
    error "malformed" value=1
    error "sequence" value=2
    error "revision" value=3
    error "features" value=4

    message "ClientHello" kind=128 direction="client-to-session" transaction="zero" {
        field "minimum_revision" type="u16" sample=1
        field "maximum_revision" type="u16" sample=2
        field "required_features" type="u64" sample=0
    }
    message "ServerWelcome" kind=129 direction="session-to-client" transaction="zero" {
        // Revision 1 advertises max_commands 258; revision 2, 259.
        field "selected_revision" type="u16" sample=2
        field "reserved" type="u16" sample=0 reserved=#true
        field "session_id_low" type="u64" sample=1
        field "session_id_high" type="u64" sample=2
        field "connection_id" type="u64" sample=1
        field "features" type="u64" sample=0
        field "max_payload" type="u32" sample=65536
        field "max_commands" type="u16" sample=259
        field "max_name_bytes" type="u16" sample=128
        field "command_timeout_ms" type="u32" sample=10000
        field "frame_timeout_ms" type="u32" sample=2000
        field "idle_timeout_ms" type="u32" sample=60000
    }
    message "CommandsRequest" kind=130 direction="client-to-session" transaction="required" {}
    message "CommandsReply" kind=131 direction="session-to-client" transaction="required" {
        field "catalog_generation" type="u64" sample=1
        field "entry_count" type="u16" sample=1 max=259
        field "reserved" type="u16" sample=0 reserved=#true
        repeated "entries" count="entry_count" max=259 {
            field "owner" type="u16" sample=1
            field "completion" type="u16" sample=1
            field "name_len" type="u16" sample=10 max=128
            field "reserved" type="u16" sample=0 reserved=#true
            field "name" type="u8" count=128 sample="focus-next"
        }
    }
    message "Invoke" kind=132 direction="client-to-session" transaction="required" {
        field "catalog_generation" type="u64" sample=1
        field "owner" type="u16" sample=1
        field "name_len" type="u16" sample=10 max=128
        field "name" type="u8" count=128 sample="focus-next"
    }
    message "CommandOutcome" kind=133 direction="session-to-client" transaction="required" {
        // Echo the requested generation, including for stale/indeterminate.
        field "catalog_generation" type="u64" sample=1
        field "outcome" type="u16" sample=1
        field "detail_len" type="u16" sample=0 max=256
        field "detail" type="u8" count=256 sample=""
    }
    message "ProtocolError" kind=134 direction="session-to-client" transaction="zero-or-offending" {
        field "error" type="u16" sample=1
        field "reserved" type="u16" sample=0 reserved=#true
    }
}
