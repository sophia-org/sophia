          "package": "sophia-input-authority",
          "target": {
            "kind": "test",
            "name": "authority_safety"
          },
          "test": "foreign_source_id_cannot_release_a_local_hold"
        },
        {
          "package": "sophia-input-authority",
          "target": {
            "kind": "test",
            "name": "pool_safety"
          },
          "test": "foreign_physical_source_must_be_registered_locally"
