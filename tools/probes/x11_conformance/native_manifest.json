      "id": "native_ingress_admission",
      "description": "Private producer admission distinguishes authorization denial, duplicate delivery identity, capacity, sequence exhaustion and unavailable/disconnected authority; every refusal returns owned work, rolls back only its own reserved credit, and preserves accepted work. Exhaustion never resets identities or silently retries forever. Consumer closure rejects later submissions and settles previously accepted work; queue poison is unavailable, not empty.",
      "mandatory": true,
      "implementation": null
    },
    {
      "id": "native_executor_order",
      "description": "Actual key, pointer, repeat, control, connection-mutation, thaw and cleanup producers share one runnable-admission order; controlled concurrency preserves completed-send precedence and exact identities at consumption, not only in returned ordinals, and saturation retains payloads and genuine completions",
      "mandatory": true,
      "implementation": null
    },
    {
      "id": "native_executor_liveness",
      "description": "Stuck before guard, inside execution and after commit fail owned instance without replay",
      "mandatory": true,
      "implementation": null
    },
    {
      "id": "native_internal_wait",
      "description": "Delay, frozen work, scheduler and control waits never accrue recipient nonresponse",
      "mandatory": true,
      "implementation": null
