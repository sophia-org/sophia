schema 1

policy { layout "scroller"; }
shell {
    enabled #true
    content #true
    panel 24
    gpu "direct"
}
shortcut {
    // This gate starts no application. An actionable session binding would
    // require an unrelated command slot and can make Hagia reject its whole
    // configuration before the panel protocol is exercised.
    profile "lom-panel-gate"
}
input { inherit-sophia #true; }
output { inherit-sophia #true; }
broker { enabled #false; }
