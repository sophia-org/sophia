schema 1

policy { layout "scroller"; }
shell {
    enabled #true
    content #true
    panel 24
    gpu "direct"
}
shortcut {
    profile "lom-panel-gate"
}
session {
    // The catalog makes Hagia's launcher action callable. The explicit empty
    // startup list independently guarantees that this panel gate starts no
    // unrelated application.
    application-catalog "lom-panel-gate"
    startup
}
input { inherit-sophia #true; }
output { inherit-sophia #true; }
broker { enabled #false; }
