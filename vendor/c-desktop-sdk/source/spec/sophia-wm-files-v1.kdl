// WM file byte contract. Independent Nim bodies and role integration remain
// under t249/h006 review; these records alone grant no admission or authority.
protocol "sophia_wm_fs_v1" api-version=1 byte-order="little" max-object-bytes=1048576 max-sections=32 {
    header size=32 {
        field "total_bytes" type="u32" offset=0
        field "api_version" type="u16" offset=4 value=1
        field "kind" type="u16" offset=6
        field "connection_epoch" type="u64" offset=8 nonzero=true
        field "submission_id" type="u64" offset=16
        field "sequence" type="u64" offset=24
    }

    // Objects have submission_id=sequence=0. Candidates have submission_id>0
    // and sequence=0. Events have submission_id=0 and sequence>0; correlated
    // submission and domain identities belong in their typed bodies.
    object "Limits" kind=1
    object "Snapshot" kind=2
    event "Negotiated" kind=16
    event "Submitted" kind=17
    event "ProfilePrepare" kind=18
    event "ProfileActivate" kind=19
    event "ProfileRollback" kind=20
    event "ConfigurationOutcome" kind=21
    event "Cycle" kind=22
    event "ProjectionOutcome" kind=23
    event "SessionOperationOutcome" kind=24
    event "PresentationReceipt" kind=25
    candidate "Negotiate" kind=256
    candidate "ProfilePrepared" kind=257
    candidate "ProfileActive" kind=258
    candidate "ProfileRolledBack" kind=259
    candidate "Configuration" kind=260
    candidate "Dirty" kind=261
    candidate "Projection" kind=262
    candidate "SessionOperation" kind=263

    body "Limits" size=32 {
        field "capability_ceiling" type="u64" offset=0
        field "max_object_bytes" type="u32" offset=8 value=1048576
        field "max_journal_bytes" type="u32" offset=12 value=1048576
        field "max_journal_records" type="u16" offset=16 value=64
        field "max_sections" type="u16" offset=18 value=32
        field "assembly_timeout_ms" type="u32" offset=20 value=12000
        field "send_timeout_ms" type="u32" offset=24 value=4000
        field "profile_required" type="u16" offset=28 min=0 max=1
        field "reserved" type="u16" offset=30 value=0
    }
    // Required and optional masks must be disjoint. Unknown bits are retained
    // for the admission owner's selection/refusal, not granted by this codec.
    body "Negotiate" size=16 {
        field "required_capabilities" type="u64" offset=0
        field "optional_capabilities" type="u64" offset=8
    }
    body "Negotiated" size=8 {
        field "selected_capabilities" type="u64" offset=0
    }
    body "ProfileCommand" size=48 kinds="ProfilePrepare,ProfileActivate,ProfileRollback" {
        field "transaction" type="u64" offset=0 nonzero=true
        field "profile_generation" type="u64" offset=8 nonzero=true
        field "profile_digest" type="bytes" offset=16 size=32 nonzero=true
    }
    body "ProfileCompletion" size=56 kinds="ProfilePrepared,ProfileActive,ProfileRolledBack" {
        field "transaction" type="u64" offset=0 nonzero=true
        field "profile_generation" type="u64" offset=8 nonzero=true
        field "profile_digest" type="bytes" offset=16 size=32 nonzero=true
        // 1 Accepted, 2 RejectedIdentity, 3 RejectedState.
        field "outcome" type="u16" offset=48 min=1 max=3
        field "reserved" type="bytes" offset=50 size=6 value=0
    }

    // Prefix offsets start after the common header. Domain transaction ids
    // do not alias the candidate submission id. Sections immediately follow.
    body-prefix "Snapshot" size=32 {
        field "transaction" type="u64" offset=0 nonzero=true
        field "scene_generation" type="u64" offset=8 nonzero=true
        field "active_output" type="u64" offset=16 nonzero=true
        field "section_count" type="u16" offset=24 max=32
        field "reserved" type="bytes" offset=26 size=6 value=0
    }
    body-prefix "Projection" size=40 {
        field "transaction" type="u64" offset=0 nonzero=true
        field "request_id" type="u64" offset=8 nonzero=true
        field "base_generation" type="u64" offset=16 nonzero=true
        field "active_output" type="u64" offset=24 nonzero=true
        field "section_count" type="u16" offset=32 max=32
        field "reserved" type="bytes" offset=34 size=6 value=0
    }
    body-prefix "Configuration" size=48 {
        field "transaction" type="u64" offset=0 nonzero=true
        field "generation" type="u64" offset=8 nonzero=true
        field "style_bits" type="u16" offset=16 mask=3
        field "section_count" type="u16" offset=18 max=32
        field "focus_width" type="u32" offset=20
        // Colours are 0x00RRGGBB, unlike the legacy scalar frame's alpha byte.
        field "focus_rgb" type="u32" offset=24 max=16777215
        field "frame_width" type="u32" offset=28
        field "frame_focused_rgb" type="u32" offset=32 max=16777215
        field "frame_unfocused_rgb" type="u32" offset=36 max=16777215
        field "reserved" type="u64" offset=40 value=0
    }

    // Followed by output_count u64 output ids, then exactly one cause body.
    body-prefix "Cycle" size=48 {
        field "snapshot_transaction" type="u64" offset=0 nonzero=true
        field "request_transaction" type="u64" offset=8 nonzero=true
        field "request_id" type="u64" offset=16 nonzero=true
        field "scene_generation" type="u64" offset=24 nonzero=true
        field "policy_generation" type="u64" offset=32 nonzero=true
        field "cause_kind" type="u16" offset=40 min=0 max=6
        field "output_count" type="u16" offset=42 min=1 max=16
        field "reserved" type="u32" offset=44 value=0
    }
    cause "SceneChanged" kind=0 size=0
    cause "Action" kind=1 size=16 {
        field "activation_serial" type="u64" offset=0 nonzero=true
        field "action" type="u64" offset=8 nonzero=true
    }
    // A surface occupies index:u32,generation:u32; only optional surfaces may
    // use (0,0). Every present surface has index!=u32::MAX and generation>0.
    cause "Focus" kind=2 size=8 {
        field "target" type="surface" offset=0
    }
    cause "PointerFocus" kind=3 size=16 {
        field "output" type="u64" offset=0 nonzero=true
        field "target" type="optional-surface" offset=8
    }
    cause "Interaction" kind=4 size=32 {
        field "phase" type="u16" offset=0 min=1 max=4
        field "kind" type="u16" offset=2 min=1 max=4
        field "axis" type="u16" offset=4 min=0 max=2
        field "reserved" type="u16" offset=6 value=0
        field "target" type="surface" offset=8
        field "x" type="i32" offset=16
        field "y" type="i32" offset=20
        field "width" type="i32" offset=24
        field "height" type="i32" offset=28
    }
    cause "OutputAction" kind=5 size=32 {
        field "activation_serial" type="u64" offset=0 nonzero=true
        field "action" type="u64" offset=8 nonzero=true
        field "output" type="u64" offset=16 nonzero=true
        field "output_generation" type="u64" offset=24 nonzero=true
    }
    cause "PresentationAction" kind=6 size=64 {
        field "activation_serial" type="u64" offset=0 nonzero=true
        field "action" type="u64" offset=8 nonzero=true
        field "publication_generation" type="u64" offset=16 nonzero=true
        field "output" type="u64" offset=24 nonzero=true
        field "output_generation" type="u64" offset=32 nonzero=true
        field "presentation_epoch" type="u64" offset=40 nonzero=true
        field "target_id" type="u64" offset=48
        field "target_generation" type="u64" offset=56
    }
    body-prefix "Dirty" size=16 {
        field "policy_generation" type="u64" offset=0 nonzero=true
        field "output_count" type="u16" offset=8 min=1 max=16
        field "reserved" type="bytes" offset=10 size=6 value=0
        // Followed by exactly output_count distinct nonzero u64 output ids.
    }
    body "SessionOperation" size=32 {
        field "transaction" type="u64" offset=0 nonzero=true
        field "request_id" type="u64" offset=8 nonzero=true
        field "operation" type="u64" offset=16 nonzero=true
        field "target" type="optional-surface" offset=24
    }
    // Projection outcomes: 1 Committed, 2 RejectedStale, 3 RejectedInvalid,
    // 4 TimedOut, 5 Disconnected. No transport ack implies any such outcome.
    body "ConfigurationOutcome" size=24 {
        field "transaction" type="u64" offset=0 nonzero=true
        field "generation" type="u64" offset=8 nonzero=true
        field "outcome" type="u16" offset=16 min=1 max=5
        field "reserved" type="bytes" offset=18 size=6 value=0
    }
    body "ProjectionOutcome" size=32 {
        field "transaction" type="u64" offset=0 nonzero=true
        field "request_id" type="u64" offset=8 nonzero=true
        field "scene_generation" type="u64" offset=16 nonzero=true
        field "outcome" type="u16" offset=24 min=1 max=5
        field "expect_session_operation" type="u16" offset=26 min=0 max=1
        field "reserved" type="u32" offset=28 value=0
    }
    body "SessionOperationOutcome" size=24 {
        field "transaction" type="u64" offset=0 nonzero=true
        field "request_id" type="u64" offset=8 nonzero=true
        field "outcome" type="u16" offset=16 min=1 max=5
        field "reserved" type="bytes" offset=18 size=6 value=0
    }
    body "PresentationReceipt" size=48 {
        field "transaction" type="u64" offset=0 nonzero=true
        field "publication_generation" type="u64" offset=8 nonzero=true
        field "output" type="u64" offset=16 nonzero=true
        field "output_generation" type="u64" offset=24 nonzero=true
        field "presentation_epoch" type="u64" offset=32 nonzero=true
        // 1 Presented, 2 Revoked, 3 Withdrawn; distinct from projection outcome.
        field "outcome" type="u16" offset=40 min=1 max=3
        field "reserved" type="bytes" offset=42 size=6 value=0
    }
    body "Submitted" size=16 {
        field "accepted_submission_id" type="u64" offset=0 nonzero=true
        field "candidate_kind" type="u16" offset=8 min=256 max=263
        field "reserved" type="bytes" offset=10 size=6 value=0
    }

    // Complete row sections, strictly ascending unique nonzero kinds. No
    // empty sections, transfer ordinals, chunk bounds or old IPC envelopes.
    // Row sizes, kinds and aggregate maxima belong to the neutral semantic
    // codec. The fixed row layouts remain those in sophia-wm-v1.kdl.
    section-header size=16 {
        field "kind" type="u16" offset=0 nonzero=true
        field "reserved" type="u16" offset=2 value=0
        field "count" type="u32" offset=4 nonzero=true
        field "byte_length" type="u32" offset=8 nonzero=true
        field "reserved_tail" type="u32" offset=12 value=0
    }

    submit size=24 {
        field "connection_epoch" type="u64" offset=0 nonzero=true
        field "submission_id" type="u64" offset=8 nonzero=true
        field "candidate_bytes" type="u32" offset=16 min=32 max=1048576
        field "reserved" type="u32" offset=20 value=0
    }
    ack size=16 {
        field "connection_epoch" type="u64" offset=0 nonzero=true
        field "sequence" type="u64" offset=8 nonzero=true
    }
}
