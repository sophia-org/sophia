// SFT extends the shell file envelope, not the transport or pixel source.
// Normative lifecycle and cross-field rules: docs/sophia-frame-transactions-wire.md.
protocol "sophia_frame_transactions_v1" shell-revision=13 capability-bit=18 envelope-api-version=1 byte-order="little" {
    candidate "FrameStreamOpen" kind=279 body-bytes=72
    candidate "FrameStreamClose" kind=280 body-bytes=72
    candidate "FrameCommit" kind=281 max-record-bytes=8192
    event "FrameStreamOpened" kind=55 body-bytes=80
    event "FrameStreamClosed" kind=56 body-bytes=80
    event "FrameRefused" kind=57 body-bytes=64
    event "FrameOutcome" kind=58 body-bytes=116

    row "StreamKey" size=64 {
        field "grant_connection_epoch" type="u64" offset=0 nonzero=#true
        field "grant_content_epoch" type="u64" offset=8 nonzero=#true
        field "output_id" type="u64" offset=16 nonzero=#true
        field "output_generation" type="u64" offset=24 nonzero=#true
        field "allocation_id" type="u64" offset=32 nonzero=#true
        field "allocation_generation" type="u64" offset=40 nonzero=#true
        field "facts_generation" type="u64" offset=48 nonzero=#true
        field "stream_id" type="u64" offset=56 nonzero=#true
    }
    body "FrameStreamOpen" size=72 {
        field "transaction" type="u64" offset=0 nonzero=#true
        field "key" type="StreamKey" offset=8
    }
    body "FrameStreamClose" size=72 {
        field "transaction" type="u64" offset=0 nonzero=#true
        field "key" type="StreamKey" offset=8
    }
    body "FrameStreamOpened" size=80 {
        field "transaction" type="u64" offset=0 nonzero=#true
        field "key" type="StreamKey" offset=8
        field "credits" type="u32" offset=72 value=1
        field "ttl_ms" type="u32" offset=76 min=1 max=250
    }
    body "FrameStreamClosed" size=80 {
        field "transaction" type="u64" offset=0 nonzero=#true
        field "key" type="StreamKey" offset=8
        field "reason" type="u16" offset=72 min=1 max=12
        field "reserved" type="bytes" offset=74 size=6 value=0
    }
    // Following this prefix: scene_bytes of neutral Candidate, optional full
    // D4C1 RingOffer (152 bytes), optional Predecessor (24 bytes), no suffix.
    body-prefix "FrameCommit" size=16 {
        field "transaction" type="u64" offset=0 nonzero=#true
        field "scene_bytes" type="u32" offset=8 min=136 max=8144
        field "flags" type="u16" offset=12 mask=3
        field "reserved" type="u16" offset=14 value=0
    }
    row "Predecessor" size=24 {
        field "transaction" type="u64" offset=0 nonzero=#true
        field "resource_id" type="u64" offset=8 nonzero=#true
        field "resource_generation" type="u64" offset=16 nonzero=#true
    }
    body "FrameRefused" size=64 {
        field "transaction" type="u64" offset=0 nonzero=#true
        field "grant_connection_epoch" type="u64" offset=8 nonzero=#true
        field "grant_content_epoch" type="u64" offset=16 nonzero=#true
        field "output_id" type="u64" offset=24 nonzero=#true
        field "output_generation" type="u64" offset=32 nonzero=#true
        field "stream_id" type="u64" offset=40 nonzero=#true
        field "candidate_generation" type="u64" offset=48
        field "request_kind" type="u16" offset=56 min=279 max=281
        field "reason" type="u16" offset=58 min=1 max=12
        field "reserved" type="u32" offset=60 value=0
    }
    // CandidateOutcome includes its transaction and retains every legacy check.
    // Prepared requires credit_expires_msec=0; terminal kinds may return one.
    body "FrameOutcome" size=116 {
        field "outcome" type="CandidateOutcome" offset=0 size=76
        field "stream_id" type="u64" offset=76 nonzero=#true
        field "allocation_id" type="u64" offset=84 nonzero=#true
        field "allocation_generation" type="u64" offset=92 nonzero=#true
        field "facts_generation" type="u64" offset=100 nonzero=#true
        field "credit_expires_msec" type="u64" offset=108
    }
}
